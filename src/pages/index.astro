---
/**
 * Inicio (v2) — piel del brochure sobre el esqueleto de un sitio de evento.
 * Copy: agente/hechos.json. Contrato: agente/DESIGN.md (v2).
 *
 * Imágenes y video: Higgsfield (IA), material provisional aprobado por Cori el
 * 2026-10-21. Cada imagen lleva data-ia="higgsfield" y está en /creditos.
 */
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Seccion from '../components/Seccion.astro';
import Pendiente from '../components/Pendiente.astro';
import Icono from '../components/Icono.astro';
import settings from '../content/settings';
import { preguntas, etapas } from '../content/evento';
import { ruta } from '../lib/rutas';

import imgHero from '../assets/ia/08-hero-autos.png';
import imgPiezas from '../assets/ia/12-linea-robots.jpg';
import imgTemaCnc from '../assets/ia/stage-1-cnc.jpg';
import imgTemaFundicion from '../assets/ia/stage-2-fundicion.jpg';
import imgTemaPlasticos from '../assets/ia/stage-3-plasticos.jpg';
import imgTemaAutomatizacion from '../assets/ia/stage-4-automatizacion.jpg';
import imgTemaMetrologia from '../assets/ia/stage-5-metrologia.jpg';
import imgTemaMantenimiento from '../assets/ia/stage-6-mantenimiento.jpg';
import imgB2b from '../assets/ia/02-b2b.png';
import imgForo from '../assets/ia/03-foro.png';
import imgCnc from '../assets/ia/10-stage-auto.jpg';
import imgEnsamble from '../assets/ia/05-ensamble.png';
import imgArneses from '../assets/ia/06-arneses.png';
import imgBanda from '../assets/ia/09-banda-autos.png';

const correo = settings.contacto.email;

// Precarga de la imagen de portada: las mismas URL AVIF que usa el <picture>
// (el <video> no lleva atributo poster: el <picture> ya cubre la vista y así
// el póster se descarga una sola vez).
// Mismo juego de anchos que el <picture> para que el navegador elija la misma URL.
const ANCHOS_HERO = [640, 960, 1280, 1920];
const posterAvif = await Promise.all(
  ANCHOS_HERO.map((w) => getImage({ src: imgHero, width: w, format: 'avif', quality: 55 }))
);
const precargaSrcset = posterAvif.map((im, i) => `${im.src} ${ANCHOS_HERO[i]}w`).join(', ');

// Cuenta regresiva: días hasta el 9 de junio de 2027 (hora de Torreón,
// America/Monterrey = UTC−6). Se calcula en el build y el JS la actualiza.
const INICIO = Date.UTC(2027, 5, 9, 6, 0, 0); // 00:00 en Torreón
const FIN = Date.UTC(2027, 5, 11, 6, 0, 0);
const diasFaltan = Math.max(0, Math.ceil((INICIO - Date.now()) / 86400000));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas
    .filter((p) => !p.pendiente)
    .map((p) => ({
      '@type': 'Question',
      name: p.pregunta,
      acceptedAnswer: { '@type': 'Answer', text: p.respuesta.replace(/<[^>]+>/g, '') },
    })),
};

const temasForo = ['Mercado e inversión industrial', 'T-MEC, aranceles y reglas de origen', 'Geopolítica y cadenas de suministro'];
// Temas del stage, cada uno con una imagen ilustrativa (Nano Banana) que va
// opaca detrás del título.
const temasStage = [
  { t: 'Maquinado CNC y herramentales', img: imgTemaCnc },
  { t: 'Fundición, formado y soldadura', img: imgTemaFundicion },
  { t: 'Plásticos y materiales avanzados', img: imgTemaPlasticos },
  { t: 'Automatización e IA aplicada', img: imgTemaAutomatizacion },
  { t: 'Metrología, calidad y trazabilidad', img: imgTemaMetrologia },
  { t: 'Mantenimiento y productividad', img: imgTemaMantenimiento },
];

const hitos = [
  {
    fecha: '8 de junio',
    titulo: 'Visitas industriales',
    condicion: 'Propuestas, sujetas a autorización. Para expositores.',
    actividades: ['Ruta A: Stellantis, Saltillo', 'Ruta B: John Deere y Lear E-Systems, La Laguna'],
  },
  {
    fecha: '9 de junio',
    titulo: 'Día 1 del evento',
    actividades: ['Exposición', 'Encuentros B2B (solo expositores)', 'Foro de Industria y Mercado', 'Stage de Conferencias Técnicas'],
  },
  {
    fecha: '10 de junio',
    titulo: 'Día 2 del evento',
    actividades: ['Exposición', 'Encuentros B2B (solo expositores)', 'Foro de Industria y Mercado', 'Stage de Conferencias Técnicas'],
  },
];
const enGratis = Date.now() < etapas.finGratis;
// Contador de la etapa gratis: valores del build; el JS los corre cada segundo.
const restaGratis = Math.max(0, etapas.finGratis - Date.now());
const cuentaGratis = [
  { u: 'd', n: Math.floor(restaGratis / 86400000), t: 'días' },
  { u: 'h', n: Math.floor(restaGratis / 3600000) % 24, t: 'horas' },
  { u: 'm', n: Math.floor(restaGratis / 60000) % 60, t: 'min' },
  { u: 's', n: Math.floor(restaGratis / 1000) % 60, t: 'seg' },
];
---

<Layout schemaExtra={[faqSchema]}>
  <link
    slot="precarga"
    rel="preload"
    as="image"
    href={posterAvif[posterAvif.length - 1].src}
    imagesrcset={precargaSrcset}
    imagesizes="100vw"
    type="image/avif"
    fetchpriority="high"
  />

  <!-- Preloader: solo existe con html.has-preloader (script del <head>). -->
  <div class="preloader" aria-hidden="true" data-preloader>
    <div class="preloader__telon"></div>
    <div class="marco preloader__marco">
      <span class="preloader__linea"></span>
      <span class="nota preloader__rotulo">Torreón · <span class="cifra">103.45° O</span></span>
      <p class="preloader__marca">
        <span class="preloader__nombre">Coahuila Automotive & Manufacturing Connect</span>
        <span class="preloader__fecha cifra">9 y 10 de junio de 2027, Torreón</span>
      </p>
    </div>
  </div>

  <!-- ================= Portada ================= -->
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="hero__medio" data-parallax-hero="0.18">
      <Picture
        src={imgHero}
        formats={['avif']}
        fallbackFormat="webp"
        widths={ANCHOS_HERO}
        sizes="100vw"
        quality={55}
        alt="Auto deportivo en holograma azul que deja ver motor, suspensión y chasis (imagen ilustrativa)"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero__poster"
        data-ia="higgsfield"
        data-poster
      />
      <video
        class="hero__video"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-video
        data-webm-1920={ruta('media/hero-1920.webm')}
        data-mp4-1920={ruta('media/hero-1920.mp4')}
        data-webm-1280={ruta('media/hero-1280.webm')}
        data-mp4-1280={ruta('media/hero-1280.mp4')}
        data-mp4-720={ruta('media/hero-720.mp4')}
      ></video>
      <div class="hero__velo"></div>
    </div>

    <div class="marco hero__marco">
      <div class="hero__contenido">
        <span class="hero__meridiano" aria-hidden="true"><span class="destello destello--torreon"></span></span>
        <img
          class="hero__logo"
          src={ruta('media/logos/coahuila-connect.svg')}
          alt="Coahuila Automotive & Manufacturing Connect"
          width="560"
          height="151"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <h1 id="hero-titulo" class="hero__h1">La manufactura de México, Estados Unidos y Canadá se conecta en Torreón</h1>
        <div class="hero__fila">
        <div class="hero__datos entra" style="--k:1">
          <p class="fecha">9 y 10 de junio de 2027</p>
          <p class="entrada">{settings.sede.nombre}</p>
        </div>
        <div
          class="cuenta entra"
          style="--k:2"
          role="timer"
          aria-live="off"
          aria-label={`Faltan ${diasFaltan} días para el 9 de junio de 2027`}
          data-cuenta
          data-inicio={INICIO}
          data-fin={FIN}
        >
          <span class="cuenta__antes nota" aria-hidden="true">Faltan</span>
          <span class="cuenta__numero cifra" aria-hidden="true" data-cuenta-numero>{diasFaltan}</span>
          <span class="cuenta__unidad nota" aria-hidden="true">días</span>
        </div>
        </div>
        <div class="hero__acciones entra" style="--k:3">
          <a class="boton boton--brillo" href={ruta('registro/')} data-cta="registrarme" data-cta-location="hero">Registrarme<span class="boton__barrido" aria-hidden="true"></span></a>
          <a class="boton boton--contorno boton--brillo" href="#expositores" data-cta="exponer_patrocinar" data-cta-location="hero">Exponer o patrocinar<span class="boton__barrido" aria-hidden="true"></span></a>
        </div>
      </div>

      <div class="hero__pie">
        <button class="hero__pausa" type="button" hidden data-pausa>
          <span class="hero__pausa-icono" data-icono-pausa><Icono nombre="pause" tamano={20} /></span>
          <span class="hero__pausa-icono" data-icono-play hidden><Icono nombre="play" tamano={20} /></span>
          <span data-pausa-texto>Pausar video</span>
        </button>
        <dl class="barra chaflan">
          <div class="barra__celda barra__celda--fecha">
            <dt class="rotulo">Fecha</dt>
            <dd>9 y 10 de junio de 2027</dd>
          </div>
          <div class="barra__celda">
            <dt class="rotulo">Sede</dt>
            <dd>{settings.sede.nombre}</dd>
          </div>
          <div class="barra__celda">
            <dt class="rotulo">Visitas industriales</dt>
            <dd>8 de junio (propuestas)</dd>
          </div>
          <div class="barra__celda">
            <dt class="rotulo">Organizan</dt>
            <dd>ANAPSA y ADN de la Manufactura</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!--
    La línea del preloader se coloca exactamente sobre el meridiano de la
    portada (misma x, mismo inicio y mismo final): es la misma línea.
    En línea para que corra antes del primer pintado del preloader.
  -->
  <script is:inline>
    (function () {
      var d = document.documentElement;
      if (!d.classList.contains('has-preloader')) return;
      var hero = document.querySelector('.hero__meridiano');
      var linea = document.querySelector('.preloader__linea');
      var rotulo = document.querySelector('.preloader__rotulo');
      if (!hero || !linea) return;
      function alinear() {
        var r = hero.getBoundingClientRect();
        linea.style.position = 'fixed';
        linea.style.left = r.left + 'px';
        linea.style.top = r.top + 'px';
        linea.style.height = r.height + 'px';
        if (rotulo) {
          rotulo.style.position = 'fixed';
          rotulo.style.left = r.left + 16 + 'px';
          rotulo.style.top = r.top - 6 + 'px';
        }
        var marca = document.querySelector('.preloader__marca');
        if (marca) {
          marca.style.position = 'fixed';
          marca.style.left = r.left + 24 + 'px';
          marca.style.top = r.top + r.height * 0.42 + 'px';
        }
      }
      alinear();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(alinear);
      window.addEventListener('resize', alinear);
    })();
  </script>

  <!-- ================= Qué es ================= -->
  <section id="que-es" class="seccion que-es" aria-labelledby="que-es-titulo">
    <div class="marco">
      <div class="que-es__texto">
        <div class="cabeza-seccion" data-escalonar>
          <h2 id="que-es-titulo">Compradores y proveedores de tres países, dos días en Torreón</h2>
          <p class="entrada">
            Coahuila Automotive & Manufacturing Connect reúne a empresas compradoras, proveedores de tecnología y
            fabricantes de distintas industrias para fortalecer la proveeduría entre México, Estados Unidos y Canadá.
          </p>
        </div>
        <p>
          Es un lugar para conocer capacidades de manufactura, encontrar soluciones industriales y abrir conversaciones
          que puedan terminar en negocio.
        </p>
        <dl class="conecta">
          <div>
            <dt>Compradores de</dt>
            <dd>Sector Automotriz, Autopartes, Componentes, así como de Manufactura Avanzada y Metalmecánica, hasta Tecnología, Automatización e IA Aplicada y Servicios Industriales y Especializados.</dd>
          </div>
          <div>
            <dt>Proveedores de</dt>
            <dd>
              Componentes, procesos de fabricación, maquinaria, automatización, materiales y servicios industriales.
              Sector Automotriz, Autopartes, Componentes, así como de Manufactura Avanzada y Metalmecánica, hasta Tecnología, Automatización e IA Aplicada y Servicios Industriales y Especializados.
            </dd>
          </div>
          <div>
            <dt>Para quienes trabajan en</dt>
            <dd>Compras, desarrollo de proveedores, ingeniería, manufactura, ventas, operaciones y dirección de planta.</dd>
          </div>
        </dl>
      </div>
    </div>
    <figure class="foto que-es__foto" data-revelar data-parallax="0.15">
      <Picture
        src={imgPiezas}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 960, 1400, 1920]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        quality={60}
        alt="Robots industriales soldando carrocerías en una línea de ensamble automotriz"
        loading="lazy"
      />
      <span class="faceta faceta--izq" aria-hidden="true"></span>
    </figure>
  </section>

  <!-- ================= Agenda (línea de tiempo) ================= -->
  <section id="agenda" class="seccion agenda" aria-labelledby="agenda-titulo" data-observar>
    <div class="marco">
      <div class="cabeza-seccion" data-escalonar>
        <h2 id="agenda-titulo">Agenda: tres días en junio de 2027</h2>
        <p class="entrada">Un día de visitas industriales y dos días de evento en el Expo Center Laguna.</p>
      </div>
      <div class="linea-tiempo">
        <span class="linea-tiempo__linea" aria-hidden="true"></span>
        <ol class="linea-tiempo__hitos">
        {
          hitos.map((h, i) => (
            <li class="hito" style={`--i:${i}`}>
              <span class="hito__marca" aria-hidden="true" />
              <p class="hito__fecha cifra">{h.fecha}</p>
              <h3 class="hito__titulo">{h.titulo}</h3>
              {h.condicion && <p class="nota hito__condicion">{h.condicion}</p>}
              <ul class="hito__lista">
                {h.actividades.map((a) => <li>{a}</li>)}
              </ul>
            </li>
          ))
        }
        </ol>
      </div>
    </div>
  </section>

  <!-- ================= Banda «Registrarme» ================= -->
  <section class="banda banda--foto union" aria-labelledby="banda-registro-titulo">
    <div class="banda__foto" data-revelar data-parallax="0.18">
      <Picture
        src={imgBanda}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 1024, 1600, 1920]}
        sizes="100vw"
        quality={55}
        alt="Chasis de un auto con el contorno de la carrocería trazado en luz naranja (imagen ilustrativa)"
        loading="lazy"
      />
    </div>
    <video
      class="banda__video"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      data-video-banda
      data-webm-1920={ruta('media/banda-autos-1920.webm')}
      data-mp4-1920={ruta('media/banda-autos-1920.mp4')}
      data-webm-1280={ruta('media/banda-autos-1280.webm')}
      data-mp4-1280={ruta('media/banda-autos-1280.mp4')}
      data-mp4-720={ruta('media/banda-autos-720.mp4')}
    ></video>
    <div class="banda__velo"></div>
    <button class="hero__pausa banda__pausa" type="button" hidden data-pausa-banda>
      <span class="hero__pausa-icono" data-icono-pausa><Icono nombre="pause" tamano={20} /></span>
      <span class="hero__pausa-icono" data-icono-play hidden><Icono nombre="play" tamano={20} /></span>
      <span data-pausa-texto>Pausar video</span>
    </button>
    <span class="destello destello--banda destello--b1" aria-hidden="true"></span>
    <span class="destello destello--banda destello--b2 destello--tarde" aria-hidden="true"></span>
    <div class="marco banda__contenido" data-escalonar>
      <h2 id="banda-registro-titulo">9 y 10 de junio, Torreón</h2>
      <p class="entrada">Regístrese gratis hasta el 31 de diciembre de 2026. Después, el boleto tiene costo.</p>
      <p>
        <a class="boton boton--brillo" href={ruta('registro/')} data-cta="registrarme" data-cta-location="banda">Registrarme<span class="boton__barrido" aria-hidden="true"></span></a>
      </p>
    </div>
  </section>

  <!-- ================= Encuentros B2B ================= -->
  <Seccion
    id="b2b"
    titulo="Encuentros B2B: 15 mesas y citas de 15 minutos"
    entrada="Agenda de citas entre compradores calificados y empresas proveedoras durante los dos días del evento."
    revelar
  >
    <div class="b2b">
      <figure class="foto b2b__foto" data-revelar>
        <div class="chaflan b2b__recorte">
          <Picture
            src={imgB2b}
            formats={['avif']}
        fallbackFormat="webp"
            widths={[480, 800, 1168]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            quality={60}
            alt="Tres personas de negocios revisan una pieza metálica y planos en una mesa de encuentros (imagen ilustrativa)"
            loading="lazy"
            data-ia="higgsfield"
          />
        </div>
      </figure>
      <div class="cifras-ancha" data-observar>
        <p class="rotulo">Meta</p>
        <p class="cifras__numero cifra"><span data-contar="380">380</span> a <span data-contar="400">400</span><span class="destello destello--cifra destello--tarde" aria-hidden="true"></span></p>
        <p class="cifras__etiqueta">citas B2B en dos días. La agenda depende de la disponibilidad y de que los perfiles coincidan.</p>
      </div>
      <div class="panel chaflan b2b__panel pila">
        <p class="fuerte">
          Las citas B2B son solo para expositores: para tener agenda es indispensable exponer. El boleto de visitante no
          incluye citas.
        </p>
        <p>
          El programa B2B tiene un patrocinio exclusivo, con cotización a la medida: presencia de marca en el área de
          encuentros, en la señalización y en la comunicación del evento.
        </p>
        <p><a class="enlace-suelto" href="#expositores" data-cta="quiero_exponer" data-cta-location="b2b">Quiero exponer</a></p>
      </div>
    </div>
  </Seccion>

  <!-- ================= Foro, stage y ponentes ================= -->
  <Seccion
    id="programa"
    titulo="Foro de industria y stage técnico"
    entrada="Temas previstos; programa y participantes por confirmar."
    revelar
  >
    <div class="foro">
      <figure class="foto foro__foto" data-revelar>
        <Picture
          src={imgForo}
          formats={['avif']}
        fallbackFormat="webp"
          widths={[480, 800, 1168]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          quality={60}
          alt="Ponente en un escenario frente a un auditorio, con un mapa de Norteamérica en la pantalla (imagen ilustrativa)"
          loading="lazy"
          data-ia="higgsfield"
        />
      </figure>
      <div class="foro__texto pila" data-escalonar>
        <h3>Foro de Industria y Mercado</h3>
        <p>
          Para escuchar a quienes deciden en la manufactura y revisar lo que está cambiando en la proveeduría entre
          México, Estados Unidos y Canadá.
        </p>
        <ul class="indice">
          {temasForo.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>

    <div class="stage">
      <div class="stage__cabeza pila">
        <h3>Stage de Conferencias Técnicas</h3>
        <p>Procesos y tecnologías de producción que se aplican en distintas industrias.</p>
      </div>
      <div class="stage__rejilla">
        <figure class="foto stage__foto" data-revelar>
          <Picture
            src={imgCnc}
            formats={['avif']}
        fallbackFormat="webp"
            widths={[480, 800, 1168]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            quality={60}
            alt="Auto en holograma azul con el chasis y el cableado iluminados en rojo (imagen ilustrativa)"
            loading="lazy"
          />
        </figure>
        {
          temasStage.map((tema, i) => (
            <div class={`panel chaflan stage__tema stage__tema--${i + 1}`}>
              <Picture
                src={tema.img}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[400, 640, 960]}
                sizes={i > 3 ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, (min-width: 480px) 50vw, 100vw'}
                quality={55}
                alt=""
                loading="lazy"
                class="stage__fondo"
                data-ia="higgsfield"
              />
              <p class="stage__titulo">{tema.t}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Seccion>

  <!-- ================= Visitas industriales ================= -->
  <section id="visitas" class="seccion visitas" aria-labelledby="visitas-titulo">
    <div class="marco">
      <div class="cabeza-seccion" data-escalonar>
        <h2 id="visitas-titulo">Visitas industriales el 8 de junio de 2027</h2>
        <p class="entrada">
          Propuestas, sujetas a autorización y disponibilidad de las plantas. Beneficio para expositores, con cupo
          limitado.
        </p>
      </div>
    </div>
    <div class="visitas__par" data-revelar>
      <figure class="foto visitas__foto visitas__foto--a" data-parallax="0.12">
        <Picture
          src={imgEnsamble}
          formats={['avif']}
        fallbackFormat="webp"
          widths={[480, 800, 1168]}
          sizes="(min-width: 768px) 55vw, 100vw"
          quality={60}
          alt="Técnico trabaja en el motor de una camioneta en una línea de ensamble (imagen ilustrativa)"
          loading="lazy"
          data-ia="higgsfield"
        />
        <figcaption class="visitas__rotulo">
          <span class="fecha">Ruta A · Saltillo</span>
          <span>El ensamble automotriz y su cadena de proveeduría.</span>
        </figcaption>
      </figure>
      <figure class="foto visitas__foto visitas__foto--b" data-parallax="0.12">
        <Picture
          src={imgArneses}
          formats={['avif']}
        fallbackFormat="webp"
          widths={[480, 800, 1168]}
