<script>
  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Etapas del boleto: la página se construye una vez; aquí se
  // corrige en el navegador cuál etapa está vigente y cuántos días quedan.
  const panelEtapas = document.querySelector<HTMLElement>('[data-etapas]');
  if (panelEtapas) {
    const fin = Number(panelEtapas.dataset.etapas);
    const gratis = Date.now() < fin;
    const [e1, e2] = Array.from(panelEtapas.querySelectorAll<HTMLElement>('.etapa'));
    e1?.classList.toggle('etapa--actual', gratis);
    e2?.classList.toggle('etapa--actual', !gratis);
    const estado = (el: HTMLElement | undefined, t: string) => {
      const s = el?.querySelector<HTMLElement>('[data-etapa-estado]');
      if (s) s.textContent = t;
    };
    estado(e1, gratis ? 'Vigente' : 'Cerrada');
    estado(e2, gratis ? 'Próxima' : 'Vigente');
    const cuenta = panelEtapas.querySelector<HTMLElement>('[data-etapa-cuenta]');
    if (cuenta) cuenta.hidden = !gratis;
    if (cuenta && gratis) {
      const celdas = ['d', 'h', 'm', 's'].map((u) => cuenta.querySelector<HTMLElement>(`[data-cuenta-u="${u}"]`));
      const correr = () => {
        const r = Math.max(0, fin - Date.now());
        const v = [Math.floor(r / 86400000), Math.floor(r / 3600000) % 24, Math.floor(r / 60000) % 60, Math.floor(r / 1000) % 60];
        celdas.forEach((c, i) => {
          const t = String(v[i]).padStart(2, '0');
          if (c && c.textContent !== t) c.textContent = t;
        });
        if (r === 0) location.reload();
      };
      correr();
      setInterval(correr, 1000);
    }
    const cta = panelEtapas.querySelector<HTMLElement>('[data-etapa-cta]');
    if (cta) cta.textContent = gratis ? 'Registrarme gratis' : 'Ir al registro';
  }

  // ---------- Parallax (v2.2): solo transform, un rAF por cuadro ----------
  // Portada: el video/póster baja a 0.18 de la velocidad del scroll (se ve más
  // lento que el texto). Fotos: la <picture> (20 % más alta que su marco) se
  // desplaza ±8 % según la posición del marco en la ventana.
  if (!sinMovimiento) {
    const heroMedio = document.querySelector<HTMLElement>('[data-parallax-hero]');
    const fotos = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'))
      .map((el) => ({ el, img: el.querySelector<HTMLElement>(':scope > picture'), f: Number(el.dataset.parallax) || 0.15, visible: false }))
      .filter((x) => x.img);
    const io = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        const x = fotos.find((f) => f.el === e.target);
        if (x) x.visible = e.isIntersecting;
      });
      pedir();
    }, { rootMargin: '10% 0px' });
    fotos.forEach((x) => io.observe(x.el));
    let pendiente = false;
    const pintar = () => {
      pendiente = false;
      const alto = window.innerHeight;
      const y = window.scrollY;
      if (heroMedio && y < alto * 1.5) {
        heroMedio.style.transform = `translate3d(0, ${(y * Number(heroMedio.dataset.parallaxHero || 0.18)).toFixed(1)}px, 0)`;
      }
      for (const x of fotos) {
        if (!x.visible || !x.img) continue;
        const r = x.el.getBoundingClientRect();
        // -1 (el marco entra por abajo) … 1 (sale por arriba)
        const p = Math.max(-1, Math.min(1, (alto / 2 - (r.top + r.height / 2)) / (alto / 2 + r.height / 2)));
        // Desplazamiento máximo: 8 % del alto del marco × (f / 0.15), tope 9 %.
        const max = Math.min(0.09, 0.08 * (x.f / 0.15)) * r.height;
        x.img.style.transform = `translate3d(0, ${(p * max).toFixed(1)}px, 0)`;
      }
    };
    const pedir = () => {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(pintar);
      }
    };
    window.addEventListener('scroll', pedir, { passive: true });
    window.addEventListener('resize', pedir);
    pedir();
  }

  // ---------- Cifras que cuentan al entrar (una vez, 900 ms, ease-out) ----------
  // El valor final ya está en el HTML; sin JS o con movimiento reducido se ve fijo.
  if (!sinMovimiento && 'IntersectionObserver' in window) {
    const numeros = document.querySelectorAll<HTMLElement>('[data-contar]');
    const contar = (el: HTMLElement) => {
      const meta = Number(el.dataset.contar);
      const t0 = performance.now();
      const paso = (t: number) => {
        const k = Math.min(1, (t - t0) / 900);
        el.textContent = String(Math.round(meta * (1 - Math.pow(1 - k, 3))));
        if (k < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    const ioC = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (e.isIntersecting) {
          e.target.querySelectorAll<HTMLElement>('[data-contar]').forEach(contar);
          ioC.unobserve(e.target);
        }
      });
    }, { rootMargin: '0px 0px -20% 0px' });
    const grupos = new Set<HTMLElement>();
    numeros.forEach((n) => grupos.add((n.closest('li, .cifras-ancha') as HTMLElement) ?? n));
    grupos.forEach((g) => {
      // Si todavía no está en pantalla, arranca en 0 para que no se vea el salto.
      if (g.getBoundingClientRect().top > window.innerHeight) {
        // Reserva el alto final (p. ej. «380 a 400» ocupa 2 líneas en móvil):
        // así contar desde 0 no mueve nada (CLS 0).
        g.querySelectorAll<HTMLElement>('.cifras__numero').forEach((c) => (c.style.minHeight = `${c.offsetHeight}px`));
        g.querySelectorAll<HTMLElement>('[data-contar]').forEach((n) => {
          // Ancho final reservado: los dígitos que crecen no empujan el resto.
          n.style.display = 'inline-block';
          n.style.minWidth = `${n.getBoundingClientRect().width}px`;
          n.style.textAlign = 'right';
          n.textContent = '0';
        });
      }
      ioC.observe(g);
    });
  }

  // ---------- Video de portada ----------
  // Fuentes del video según el ancho. En teléfonos, solo MP4 (H.264) de 720 px:
  // el teléfono lo decodifica con su chip de video y no traba la página.
  const ponerFuentes = (v: HTMLVideoElement) => {
    const telefono = window.innerWidth <= 600;
    const ancho = telefono ? '720' : window.innerWidth <= 900 ? '1280' : '1920';
    for (const f of telefono ? ['mp4'] : ['webm', 'mp4']) {
      const src = v.getAttribute(`data-${f}-${ancho}`);
      if (!src) continue;
      const s = document.createElement('source');
      s.type = `video/${f}`;
      s.src = src;
      v.appendChild(s);
    }
  };

  const video = document.querySelector<HTMLVideoElement>('[data-video]');
  const pausa = document.querySelector<HTMLButtonElement>('[data-pausa]');
  const reducido = sinMovimiento;
  const ahorro = (navigator as any).connection?.saveData === true;
  if (video && pausa && !reducido && !ahorro) {
    let listo = false;
    let pausadoPorUsuario = false;
    let enPantalla = true;
    const texto = pausa.querySelector<HTMLElement>('[data-pausa-texto]');
    const iconoPausa = pausa.querySelector<HTMLElement>('[data-icono-pausa]');
    const iconoPlay = pausa.querySelector<HTMLElement>('[data-icono-play]');
    const pintarBoton = () => {
      const corriendo = !video.paused;
      if (texto) texto.textContent = corriendo ? 'Pausar video' : 'Reproducir video';
      if (iconoPausa) iconoPausa.hidden = !corriendo;
      if (iconoPlay) iconoPlay.hidden = corriendo;
    };
    const intentar = () => {
      if (!listo || pausadoPorUsuario || !enPantalla || document.hidden) return;
      video.play().catch(() => {});
    };
    video.addEventListener('playing', () => {
      video.classList.add('activo');
      pausa.hidden = false;
      pintarBoton();
    });
    video.addEventListener('pause', pintarBoton);
    // El video arranca cuando la página ya cargó y el navegador está libre: el
    // póster cubre mientras tanto, así no compite con la primera pintura.
    const arrancar = () => {
      ponerFuentes(video);
      video.load();
      listo = true;
      intentar();
    };
    const enReposo = () =>
      'requestIdleCallback' in window ? (window as any).requestIdleCallback(arrancar, { timeout: 2500 }) : setTimeout(arrancar, 800);
    if (document.readyState === 'complete') enReposo();
    else window.addEventListener('load', enReposo, { once: true });
    pausa.addEventListener('click', () => {
      if (video.paused) {
        pausadoPorUsuario = false;
        intentar();
      } else {
        pausadoPorUsuario = true;
        video.pause();
      }
    });
    new IntersectionObserver(([e]) => {
      enPantalla = e.isIntersecting;
      if (enPantalla) intentar();
      else video.pause();
    }).observe(video);
    document.addEventListener('visibilitychange', () => (document.hidden ? video.pause() : intentar()));
  }

  // ---------- Video de la banda «Registrarme»: solo corre cuando se ve ----------
  const videoBanda = document.querySelector<HTMLVideoElement>('[data-video-banda]');
  const pausaBanda = document.querySelector<HTMLButtonElement>('[data-pausa-banda]');
  if (videoBanda && pausaBanda && !sinMovimiento && (navigator as any).connection?.saveData !== true) {
    let cargado = false;
    let pausado = false;
    const texto = pausaBanda.querySelector<HTMLElement>('[data-pausa-texto]');
    const iPausa = pausaBanda.querySelector<HTMLElement>('[data-icono-pausa]');
    const iPlay = pausaBanda.querySelector<HTMLElement>('[data-icono-play]');
    const pintar = () => {
      const corriendo = !videoBanda.paused;
      if (texto) texto.textContent = corriendo ? 'Pausar video' : 'Reproducir video';
      if (iPausa) iPausa.hidden = !corriendo;
      if (iPlay) iPlay.hidden = corriendo;
    };
    videoBanda.addEventListener('playing', () => {
      videoBanda.classList.add('activo');
      pausaBanda.hidden = false;
      pintar();
    });
    videoBanda.addEventListener('pause', pintar);
    pausaBanda.addEventListener('click', () => {
      pausado = !videoBanda.paused;
      if (pausado) videoBanda.pause();
      else videoBanda.play().catch(() => {});
    });
    new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return videoBanda.pause();
        if (!cargado) {
          cargado = true;
          ponerFuentes(videoBanda);
          videoBanda.load();
        }
        if (!pausado) videoBanda.play().catch(() => {});
      },
      { rootMargin: '200px 0px' }
    ).observe(videoBanda);
  }

  // ---------- Cuenta regresiva (solo días; se actualiza cada minuto) ----------
  const cuenta = document.querySelector<HTMLElement>('[data-cuenta]');
  if (cuenta) {
    const numero = cuenta.querySelector<HTMLElement>('[data-cuenta-numero]');
    const inicioEvento = Number(cuenta.dataset.inicio);
    const finEvento = Number(cuenta.dataset.fin);
    const pintar = () => {
      const ahora = Date.now();
      if (ahora >= finEvento) {
        cuenta.hidden = true;
        return;
      }
      if (ahora >= inicioEvento) {
        cuenta.innerHTML = '<span class="cuenta__hoy">Hoy, en el Expo Center Laguna</span>';
        cuenta.setAttribute('aria-label', 'Hoy, en el Expo Center Laguna');
        return;
      }
      const dias = Math.ceil((inicioEvento - ahora) / 86400000);
      if (numero) numero.textContent = String(dias);
      cuenta.setAttribute('aria-label', `Faltan ${dias} días para el 9 de junio de 2027`);
    };
    pintar();
    setInterval(pintar, 60000);
  }
</script>

<style>
  /* ================= Preloader =================
     Todo en CSS (el script del <head> solo pone la clase): el meridiano se
     dibuja (0–700 ms), aparecen el nombre (500–900 ms) y la fecha (750–1050 ms),
     y a los 1300 ms el telón se abre en diagonal «/» (400 ms). Tope duro: a
     los 2 s la capa queda oculta pase lo que pase. */
  .preloader {
    display: none;
  }
  :global(html.has-preloader) .preloader {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    animation: preloader-salir 0s linear 2s forwards;
  }
  .preloader__telon {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: calc(100% + 25vh);
    background: var(--color-navy);
    /* Borde derecho en faceta «/». */
    clip-path: polygon(0 0, 100% 0, calc(100% - 25vh) 100%, 0 100%);
    animation: preloader-abrir 400ms var(--curva) 1300ms forwards;
  }
  .preloader__marco {
    position: relative;
    height: 100%;
  }
  .preloader__linea {
    position: absolute;
    left: 8px;
    top: calc(var(--cabecera) + 40px);
    height: 60%;
    width: 1px;
    background: var(--color-signal-cyan);
    transform-origin: top;
    animation: preloader-linea 700ms var(--curva) both;
  }
  .preloader__rotulo {
    position: absolute;
    left: 24px;
    top: calc(var(--cabecera) + 34px);
    white-space: nowrap;
    max-width: none;
    animation:
      preloader-aparecer 300ms var(--curva) 200ms both,
      preloader-irse 200ms var(--curva) 1150ms forwards;
  }
  .preloader__marca {
    position: absolute;
    left: 32px;
    top: 45%;
    max-width: min(40rem, calc(100vw - 64px));
    display: grid;
    gap: var(--spacing-sm);
    animation: preloader-irse 200ms var(--curva) 1150ms forwards;
  }
  .preloader__nombre {
    font-family: var(--font-display);
    font-size: var(--text-headline-lg);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.015em;
    font-variation-settings: 'wdth' 116;
    color: var(--color-on-navy);
    animation: preloader-subir 400ms var(--curva) 500ms both;
  }
  .preloader__fecha {
    font-size: var(--text-label-md);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-signal-cyan);
    animation: preloader-aparecer 300ms var(--curva) 750ms both;
  }
  @keyframes preloader-linea {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes preloader-aparecer {
    from {
      opacity: 0;
    }
  }
  @keyframes preloader-subir {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @keyframes preloader-irse {
    to {
      opacity: 0;
    }
  }
  @keyframes preloader-abrir {
    to {
      transform: translateX(calc(-100% - 25vh));
    }
  }
  @keyframes preloader-salir {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ================= Portada ================= */
  .hero {
    position: relative;
    min-height: max(680px, 100svh);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hero__medio {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__medio :global(picture),
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__poster,
  .hero__video {
    object-fit: cover;
    object-position: 70% 50%;
  }
  .hero__video {
    opacity: 0;
    transition: opacity 400ms var(--curva);
  }
  .hero__video:global(.activo) {
    opacity: 1;
  }
  /* Velo marino (único degradado permitido): ≥ 0.80 bajo el texto. */
  .hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(0 17 47 / 0.85) 0, rgb(0 17 47 / 0.8) var(--cabecera), rgb(0 17 47 / 0) calc(var(--cabecera) + 120px)),
      linear-gradient(to top, var(--color-navy) 0%, rgb(0 17 47 / 0.85) 22%, rgb(0 17 47 / 0) 48%),
      linear-gradient(to right, rgb(0 17 47 / 0.92) 0%, rgb(0 17 47 / 0.8) 62%, rgb(0 17 47 / 0.25) 100%);
  }
  @media (max-width: 767px) {
    .hero__velo {
      background: linear-gradient(to top, var(--color-navy) 0%, rgb(0 17 47 / 0.86) 40%, rgb(0 17 47 / 0.8) 100%);
    }
  }
  /* Logo del evento en grande sobre el título (pedido del cliente). */
  .hero__logo {
    display: block;
    width: min(100%, 300px);
    height: auto;
    margin-bottom: var(--spacing-lg);
    /* El SVG trae margen a la izquierda: se recorre para alinear con el título. */
    transform: translateX(-3.6%);
    filter: drop-shadow(0 0 24px rgb(1 246 250 / 0.25));
  }
  @media (min-width: 768px) {
    .hero__logo {
      width: 460px;
    }
  }
  @media (min-width: 1280px) {
    .hero__logo {
      width: 560px;
    }
  }
  .hero__marco {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    padding-top: calc(var(--cabecera) + 40px);
    padding-bottom: var(--spacing-xl);
  }
  .hero__contenido {
    position: relative;
  }
  /* Meridiano de Torreón: móvil a 8 px del borde, alto del bloque de texto. */
  .hero__meridiano {
    position: absolute;
    left: calc(8px - var(--margen));
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-signal-cyan);
    transform-origin: top;
  }
  .hero__h1 {
    max-width: none;
  }
  /* Móvil: ancho de letra 100 y 32–36 px para quedar en ≤ 5 líneas a 390 px
     (y no pasar de 6 en 320 px). */
  @media (max-width: 767px) {
    .hero__h1 {
      font-size: clamp(2rem, 9.2vw, 2.25rem);
      font-variation-settings: 'wdth' 100;
    }
  }
  .hero__datos {
    margin-top: var(--spacing-lg);
  }
  .hero__datos .entrada {
    margin-top: 4px;
  }
  .cuenta {
    margin-top: var(--spacing-lg);
    display: grid;
    grid-template-columns: auto;
    justify-items: start;
  }
  .cuenta__numero {
    font-family: var(--font-display);
    font-size: var(--text-headline-lg);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.015em;
    font-variation-settings: 'wdth' 116;
    color: var(--color-on-navy);
  }
  .cuenta :global(.cuenta__hoy) {
    font-weight: 600;
  }
  .hero__acciones {
    margin-top: var(--spacing-xl);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-md) var(--spacing-lg);
  }
  .hero__pie {
    position: relative;
    margin-top: calc(var(--spacing-xl) + 52px);
  }
  .hero__pausa {
    position: absolute;
    right: 0;
    bottom: calc(100% + 8px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 8px;
    border: 0;
    background: transparent;
    color: var(--color-on-navy);
    font: inherit;
    font-size: var(--text-label-md);
    font-weight: 600;
    cursor: pointer;
    border-radius: var(--radius-sm);
  }
  .hero__pausa[hidden] {
    display: none;
  }
  .hero__pausa-icono {
    display: inline-flex;
  }
  .hero__pausa-icono[hidden] {
    display: none;
  }
  .barra {
    margin: 0;
    background: var(--color-navy-panel);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .barra__celda {
    padding: 20px 24px;
    min-width: 0;
  }
  .barra__celda:nth-child(2n) {
    border-left: 1px solid var(--color-navy);
  }
  .barra__celda:nth-child(n + 3) {
    border-top: 1px solid var(--color-navy);
  }
  .barra dd {
    margin: 6px 0 0;
    font-weight: 600;
  }
  @media (max-width: 479px) {
    .barra__celda {
      padding: 16px;
    }
    .barra dt {
      overflow-wrap: normal;
      hyphens: none;
    }
  }
  /* En 320–359 px «Visitas industriales» no cabe en media celda: una columna. */
  @media (max-width: 359px) {
    .barra {
      grid-template-columns: minmax(0, 1fr);
    }
    .barra__celda:nth-child(2n) {
      border-left: 0;
    }
    .barra__celda + .barra__celda {
      border-top: 1px solid var(--color-navy);
    }
  }
  @media (min-width: 1024px) {
    .hero__marco {
      padding-top: calc(var(--cabecera) + 96px);
    }
    .hero__meridiano {
      left: -24px;
      /* Baja hasta la barra de datos y toca la celda de la fecha con un tic. */
      bottom: calc(-1 * (var(--spacing-xl) + 52px + 34px));
    }
    .hero__meridiano::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: var(--spacing-tick);
      height: 1px;
      background: var(--color-signal-cyan);
    }
    /* v2.2: h1 de 64 px en 3 líneas a 1440 px (pedido de Cori: título más chico). */
    .hero__h1 {
      max-width: 24ch;
    }
    .hero__fila {
      display: flex;
      align-items: flex-end;
      gap: var(--spacing-2xl);
      margin-top: var(--spacing-lg);
    }
    .hero__fila .hero__datos,
    .hero__fila .cuenta {
      margin-top: 0;
    }
    .barra {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .barra__celda + .barra__celda {
      border-left: 1px solid var(--color-navy);
      border-top: 0;
    }
  }

  /* Secuencia de entrada: CSS puro, con retraso si hay preloader. Sin JS
     (sin html.js) no hay estado inicial oculto. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__meridiano {
      animation: entra-linea 700ms var(--curva) var(--retraso-linea, 0ms) both;
    }
    /* Cascada de la portada (v2.2): titular → fecha → cuenta → acciones →
       barra, 720 ms cada uno y 80 ms entre sí; con preloader arranca cuando el
       telón se abre (--retraso). */
    :global(html.js) .hero__h1 {
      animation: entra-sube 760ms var(--curva) var(--retraso, 0ms) both;
    }
    :global(html.js) .entra {
      animation: entra-sube 720ms var(--curva) calc(var(--retraso, 0ms) + 160ms + var(--k, 1) * 80ms) both;
    }
    :global(html.js) .hero__pie {
      animation: entra-sube 720ms var(--curva) calc(var(--retraso, 0ms) + 520ms) both;
    }
    /* Con preloader, la línea del preloader es la que se dibuja: la de la
       portada queda estática debajo (sin depender del JS). */
    :global(html.con-preloader) {
      --retraso: 1300ms;
    }
    :global(html.con-preloader) .hero__meridiano {
      animation: none;
    }
  }
  @keyframes entra-linea {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes entra-sube {
    from {
      opacity: 0;
      transform: translate3d(0, 20px, 0);
    }
  }
  @keyframes entra-sube-16 {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @keyframes entra-opacidad {
    from {
      opacity: 0;
    }
  }

  /* ================= Destellos (v2.2, pedido de Cori) =================
     Pocos y puntuales (máx. 3 por pantalla): punto de Torreón en la portada,
     dos cifras B2B y dos chispas en la banda de la red. Solo CSS
     (radial-gradient); se animan opacidad y transform. Con movimiento
     reducido quedan fijos a media intensidad. */
  .destello {
    position: absolute;
    width: 36px;
    height: 36px;
    pointer-events: none;
    background: radial-gradient(circle, rgb(244 247 251 / 0.95) 0 6%, rgb(1 246 250 / 0.55) 16%, rgb(1 246 250 / 0) 62%);
    opacity: 0.55;
  }
  .destello::before,
  .destello::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220%;
    height: 1px;
    background: linear-gradient(to right, rgb(1 246 250 / 0), rgb(244 247 251 / 0.8), rgb(1 246 250 / 0));
    transform: translate(-50%, -50%);
  }
  .destello::after {
    transform: translate(-50%, -50%) rotate(90deg);
    width: 160%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .destello {
      animation: destellar 5.5s var(--curva) infinite;
    }
    .destello--tarde {
      animation-delay: 2.4s;
    }
  }
  @keyframes destellar {
    0%,
    62%,
    100% {
      opacity: 0.35;
      transform: scale(0.8) rotate(0deg);
    }
    74% {
      opacity: 1;
      transform: scale(1.15) rotate(45deg);
    }
    86% {
      opacity: 0.5;
      transform: scale(0.9) rotate(90deg);
    }
  }
  .destello--torreon {
    left: -18px;
    top: -18px;
  }
  .destello--cifra {
    position: relative;
    display: inline-block;
    vertical-align: top;
    width: 28px;
    height: 28px;
    margin-left: 4px;
  }
  .destello--banda {
    z-index: 1;
    width: 44px;
    height: 44px;
  }
  .destello--b1 {
    right: 26%;
    top: 34%;
  }
  .destello--b2 {
    right: 12%;
    top: 58%;
  }
  @media (max-width: 767px) {
    .destello--b2 {
      display: none;
    }
  }

  /* ================= Faceta (corte 1:4 con triángulo del color de fondo) ================= */
  .faceta {
    position: absolute;
    background: var(--color-navy);
    pointer-events: none;
  }
  .faceta--izq {
    left: -1px;
    top: 0;
    height: 100%;
    aspect-ratio: 1 / 4;
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }

  /* ================= Qué es ================= */
  .conecta {
    margin: var(--spacing-xl) 0 0;
  }
  .conecta > div {
    padding-block: 16px;
    border-top: 1px solid var(--color-navy-panel);
  }
  .conecta > div:last-child {
    border-bottom: 1px solid var(--color-navy-panel);
  }
  .conecta dt,
  .ficha dt {
    font-weight: 600;
  }
  .conecta dd,
  .ficha dd {
    margin: 4px 0 0;
    max-width: var(--spacing-measure);
    color: var(--color-on-navy-muted);
  }
  .que-es__texto > p {
    margin-top: var(--spacing-lg);
  }
  .que-es__foto {
    margin: var(--spacing-xl) 0 0;
    aspect-ratio: 16 / 10;
  }
  .que-es__foto .faceta--izq {
    display: none;
  }
  /* Centrar la carrocería de la línea de robots al recortar en columna alta. */
  .que-es__foto :global(img) {
    object-position: 58% 50%;
  }
  @media (max-width: 1023px) {
    .que-es__foto::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: var(--subida);
      background: var(--color-navy);
      clip-path: polygon(100% 100%, 0 100%, 0 0);
    }
  }
  @media (min-width: 1024px) {
    .que-es__texto {
      width: calc((100% - 11 * var(--spacing-gutter)) / 12 * 6 + 5 * var(--spacing-gutter));
    }
    .que-es__foto {
      position: absolute;
      margin: 0;
      top: calc(var(--seccion) / 2);
      bottom: calc(var(--seccion) / 2);
      right: 0;
      /* Desde la columna 7 hasta el borde de la ventana. */
      left: calc(
        max(0px, (100% - var(--spacing-container)) / 2) + var(--margen) +
          (min(100%, var(--spacing-container)) - 2 * var(--margen) - 11 * var(--spacing-gutter)) / 12 * 6 + 6 *
          var(--spacing-gutter)
      );
      aspect-ratio: auto;
    }
    .que-es__foto .faceta--izq {
      display: block;
    }
  }

  /* ================= Agenda: línea de tiempo ================= */
  /* Móvil: línea vertical a la izquierda; escritorio: horizontal arriba de
     los tres hitos. La línea es cian de 1 px; cada hito cuelga de ella con
     una marca de 16 px. */
  .linea-tiempo {
    position: relative;
    padding-left: 32px;
  }
  .linea-tiempo__hitos {
    list-style: none;
    display: grid;
    gap: var(--spacing-2xl);
  }
  .linea-tiempo__linea {
    position: absolute;
    left: 0;
    top: 0.6em;
    bottom: 0;
    width: 1px;
    background: var(--color-signal-cyan);
    transform-origin: top;
  }
  .hito {
    position: relative;
    min-width: 0;
  }
  .hito__marca {
    position: absolute;
    left: -32px;
    top: calc(var(--text-headline-lg) * 0.5);
    width: var(--spacing-tick);
    height: 1px;
    background: var(--color-signal-cyan);
  }
  .hito__fecha {
    font-family: var(--font-display);
    font-size: var(--text-headline-lg);
    font-weight: 900;
    line-height: 1.04;
    letter-spacing: -0.015em;
    font-variation-settings: 'wdth' 116;
    color: var(--color-signal-cyan);
    max-width: none;
  }
  .hito__titulo {
    margin-top: var(--spacing-sm);
  }
  .hito__condicion {
    margin-top: var(--spacing-sm);
  }
  .hito__lista {
    list-style: none;
    margin-top: var(--spacing-md);
  }
  .hito__lista li {
    padding-block: 8px;
    border-top: 1px solid var(--color-navy-panel);
  }
  .hito__lista li:last-child {
    border-bottom: 1px solid var(--color-navy-panel);
  }
  .hito__horario {
    margin-top: var(--spacing-md);
  }
  @media (min-width: 1024px) {
    .linea-tiempo {
      padding-left: 0;
      padding-top: 40px;
    }
    .linea-tiempo__hitos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--spacing-gutter);
    }
    .linea-tiempo__linea {
      top: 0;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 1px;
      transform-origin: left;
    }
    .hito__marca {
      left: 0;
      top: -40px;
      width: 1px;
      height: 24px;
    }
  }
  /* Animación: la línea se dibuja al entrar la agenda y los hitos aparecen en
     orden. Sin JS o con movimiento reducido, todo ya está. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .linea-tiempo__linea {
      transform: scaleY(0);
      transition: transform 900ms var(--curva);
    }
    :global(html.js) .agenda:global(.revelado) .linea-tiempo__linea {
      transform: none;
    }
    :global(html.js) .hito {
      opacity: 0;
      transform: translateY(16px);
      transition:
        opacity 400ms var(--curva) calc(300ms + var(--i) * 250ms),
        transform 400ms var(--curva) calc(300ms + var(--i) * 250ms);
    }
    :global(html.js) .agenda:global(.revelado) .hito {
      opacity: 1;
      transform: none;
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(html.js) .linea-tiempo__linea {
      transform: scaleX(0);
    }
  }

  /* ================= Bandas ================= */
  .banda {
    position: relative;
    min-height: clamp(360px, 40vw, 480px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .banda__foto {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* La <picture> la coloca la regla global de [data-parallax] (20 % más alta). */
  .banda__foto :global(img) {
    width: 100%;
    height: 100%;
  }
  .banda__foto :global(img) {
    object-fit: cover;
    object-position: 60% 50%;
  }
  .banda__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    opacity: 0;
    transition: opacity 400ms var(--curva);
  }
  .banda__video:global(.activo) {
    opacity: 1;
  }
  .banda__pausa {
    top: auto;
    bottom: 8px;
    right: 8px;
    z-index: 1;
  }
  .logos-fila {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .banda__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(0 17 47 / 0.88) 0%, rgb(0 17 47 / 0.8) 50%, rgb(0 17 47 / 0.2) 100%);
  }
  @media (max-width: 767px) {
    .banda__velo {
      background: rgb(0 17 47 / 0.8);
    }
  }
  .banda__contenido {
    position: relative;
    width: 100%;
    padding-block: var(--spacing-2xl);
  }
  .banda__contenido > * + * {
    margin-top: var(--spacing-lg);
  }

  /* ================= B2B ================= */
  .b2b {
    display: grid;
    gap: var(--spacing-xl);
  }
  .b2b__recorte {
    aspect-ratio: 4 / 3;
  }
  .b2b__recorte :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .b2b__foto {
    margin: 0;
    background: transparent;
  }
  .cifras {
    list-style: none;
    display: grid;
    gap: var(--spacing-xl);
    align-content: center;
  }
  .cifras li {
    display: grid;
    gap: 4px;
  }
  .cifras__numero {
    font-family: var(--font-display);
    font-size: var(--text-figure);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variation-settings: 'wdth' 112;
    color: var(--color-signal-cyan);
    max-width: none;
  }
  .cifras__prefijo {
    display: block;
    font-size: var(--text-headline-md);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.15;
    font-variation-settings: 'wdth' 108;
  }
  .cifras__unidad {
    font-size: var(--text-headline-md);
    letter-spacing: 0;
    margin-left: 8px;
  }
  .cifras__etiqueta {
    font-size: var(--text-label-md);
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-on-navy-muted);
  }
  .cifras-ancha {
    border-top: 1px solid var(--color-navy-panel);
    padding-top: var(--spacing-xl);
    display: grid;
    gap: var(--spacing-sm);
  }
  @media (min-width: 1024px) {
    .b2b {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--spacing-gutter);
      row-gap: var(--spacing-2xl);
    }
    .b2b__foto {
      grid-column: 1 / span 6;
    }
    .cifras-ancha {
      grid-column: 1 / -1;
      grid-row: 2;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      column-gap: var(--spacing-xl);
    }
    .cifras-ancha .rotulo {
      grid-column: 1 / -1;
    }
