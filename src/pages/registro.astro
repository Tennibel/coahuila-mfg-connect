---
/**
 * /registro — formulario de visitante.
 *
 * Dos modos según PUBLIC_REGISTRO_API (lo define scripts/build-dominio.sh):
 * - Con API (coahuilamfgconnect.com): guarda el registro en la base de datos
 *   del hosting (servidor/api/registro.php) y muestra el folio y el QR.
 * - Sin API (GitHub Pages): VISTA PREVIA que no cobra, no guarda y no envía nada. Lo dice arriba y
 * junto al botón. Al «enviar» valida en el navegador y muestra lo que pasaría
 * con el registro activo (QR por correo → acceso) y un QR de
 * MUESTRA que no se puede escanear. Nunca dice «ya está registrado».
 *
 * Sin JavaScript el botón queda desactivado: así el formulario no puede
 * mandar datos en la URL. Cuando exista el servidor de cobro, este formulario
 * se conecta ahí (con validación en servidor, límite por IP y el campo trampa).
 */
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import imgMotor from '../assets/ia/11-registro-motor.jpg';
import Pendiente from '../components/Pendiente.astro';
import { ruta } from '../lib/rutas';
import { etapas } from '../content/evento';

const areas = ['Compras', 'Desarrollo de proveedores', 'Ingeniería', 'Manufactura', 'Operaciones', 'Dirección de planta', 'Otra'];
const paises = ['México', 'Estados Unidos', 'Canadá', 'Otro'];
// Tipo de empresa (Cori, 2026-10-26).
const tipos = ['Empresa compradora', 'Empresa proveedora', 'Empresa de servicios', 'Empresa patrocinadora'];
const enGratis = Date.now() < etapas.finGratis;
const api = import.meta.env.PUBLIC_REGISTRO_API ?? '';
const real = Boolean(api);

---

<Layout
  title={real ? 'Registro de visitante · Coahuila MFG Connect 2027' : 'Registro de visitante (vista previa) · Coahuila MFG Connect'}
  description={real
    ? 'Regístrese gratis como visitante a Coahuila Automotive & Manufacturing Connect: 9 y 10 de junio de 2027, Expo Center Laguna, Torreón. Reciba su QR por correo.'
    : 'Vista previa del registro de visitante de Coahuila Automotive & Manufacturing Connect. Todavía no cobra ni guarda datos.'}
  noindex={!real}
>
  <!-- Cabecera marina corta: h1 + aviso de vista previa -->
  <div class="registro__cabeza">
    <div class="registro__fondo" aria-hidden="true">
      <Picture
        src={imgMotor}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        quality={55}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
      <div class="registro__velo"></div>
    </div>
    <div class="marco reticula registro__marco">
      <div class="col-contenido pila-lg">
        <h1>Registro de visitante</h1>
        <p class="entrada">
          9 y 10 de junio de 2027, Expo Center Laguna. Expositores y patrocinadores:
          <a href={ruta('#expositores')}>escríbanos</a>, no se registran aquí.
        </p>
        {!real && (
          <p class="aviso-previa" role="note">
            <span class="rotulo aviso-previa__rotulo">Vista previa</span>
            Este formulario todavía no cobra ni guarda datos. Puede llenarlo para ver cómo funcionará; no se enviará nada.
          </p>
        )}
      </div>
      <div class="col-margen registro__margen nota pila">
        <p>Boleto de visitante: gratis hasta el 31 de diciembre de 2026. Desde el 1 de enero de 2027 tendrá costo.</p>
        <p>Las citas B2B son para expositores.</p>
      </div>
    </div>
  </div>

  <!-- Formulario en sección clara -->
  <div class="pagina claro registro__claro">
    <div class="marco">
      <div class="reticula">
        <div class="col-contenido">
          <form id="form-registro" class="form" novalidate aria-describedby="nota-previa" data-api={api}>
            <fieldset>
              <legend class="form__grupo">Sus datos</legend>
              <div class="form__fila">
                <div class="campo">
                  <label for="nombre">Nombre(s)</label>
                  <input id="nombre" name="nombre" type="text" autocomplete="given-name" required data-error="Escriba su nombre." />
                  <p class="campo__error" id="nombre-error" hidden></p>
                </div>
                <div class="campo">
                  <label for="apellidos">Apellidos</label>
                  <input id="apellidos" name="apellidos" type="text" autocomplete="family-name" required data-error="Escriba sus apellidos." />
                  <p class="campo__error" id="apellidos-error" hidden></p>
                </div>
              </div>
              <div class="form__fila">
                <div class="campo">
                  <label for="correo">Correo electrónico</label>
                  <input id="correo" name="correo" type="email" autocomplete="email" inputmode="email" required data-error="Escriba un correo válido, por ejemplo nombre@empresa.com." />
                  <p class="campo__ayuda">{real ? 'Aquí le llegará su QR.' : 'Aquí le llegaría su QR.'}</p>
                  <p class="campo__error" id="correo-error" hidden></p>
                </div>
                <div class="campo">
                  <label for="telefono">Teléfono</label>
                  <input id="telefono" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required pattern={"[0-9 +\\(\\)\\-]{8,20}"} data-error="Escriba un teléfono de al menos 8 dígitos, con lada." />
                  <p class="campo__error" id="telefono-error" hidden></p>
                </div>
              </div>
            </fieldset>

            <fieldset>
              <legend class="form__grupo">Su empresa</legend>
              <div class="form__fila">
                <div class="campo">
                  <label for="empresa">Empresa</label>
                  <input id="empresa" name="empresa" type="text" autocomplete="organization" required data-error="Escriba el nombre de su empresa." />
                  <p class="campo__error" id="empresa-error" hidden></p>
                </div>
                <div class="campo">
                  <label for="cargo">Cargo</label>
                  <input id="cargo" name="cargo" type="text" autocomplete="organization-title" required data-error="Escriba su cargo." />
                  <p class="campo__error" id="cargo-error" hidden></p>
                </div>
              </div>
              <fieldset class="opciones opciones--tipo" data-grupo="tipo" data-error="Elija el tipo de empresa.">
                <legend class="campo__leyenda">Tipo de empresa</legend>
                <div class="tipos">
                  {tipos.map((t, i) => (
                    <label class="opcion" for={`tipo-${i}`}>
                      <input id={`tipo-${i}`} type="radio" name="tipo" value={t} required />
                      <span>{t}</span>
                    </label>
                  ))}
                </div>
                <p class="campo__error" id="tipo-error" hidden></p>
              </fieldset>
              <div class="form__fila">
                <div class="campo">
                  <label for="area">Área en la que trabaja</label>
                  <select id="area" name="area" required data-error="Elija su área.">
                    <option value="">Elija una opción</option>
                    {areas.map((a) => <option>{a}</option>)}
                  </select>
                  <p class="campo__error" id="area-error" hidden></p>
                </div>
                <div class="campo">
                  <label for="pais">País</label>
                  <select id="pais" name="pais" autocomplete="country-name" required data-error="Elija su país.">
                    <option value="">Elija una opción</option>
                    {paises.map((p) => <option>{p}</option>)}
                  </select>
                  <p class="campo__error" id="pais-error" hidden></p>
                </div>
              </div>
            </fieldset>

            <fieldset class="opciones" data-grupo="pago" data-fin-gratis={etapas.finGratis}>
              <legend class="form__grupo">Boleto</legend>
              <p class="opciones__boleto">
                Gratis si se registra a más tardar el 31 de diciembre de 2026. Desde el 1 de enero de 2027 tendrá
                costo.
              </p>
              <p class="opciones__gratis" data-pago-gratis hidden={!enGratis}>
                <span class="fuerte">Hoy su registro es gratis:</span> no tiene que pagar nada.
              </p>
              <p data-pago-opciones hidden={enGratis}>La forma de pago se dará a conocer próximamente.</p>
            </fieldset>

            <!-- Campo trampa antispam: invisible para personas. -->
            <div class="trampa" aria-hidden="true">
              <label for="sitio_web">No llene este campo</label>
              <input id="sitio_web" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <label class="opcion opcion--acepto" for="acepto">
              <input id="acepto" name="acepto" type="checkbox" required data-error="Para continuar, confirme que leyó el aviso de privacidad." />
              <span>
                Leí el <a href={ruta('aviso-de-privacidad/')}>aviso de privacidad</a> y acepto el tratamiento de mis datos para
                registrarme.
              </span>
            </label>
            <p class="campo__error" id="acepto-error" hidden></p>

            <div class="form__envio">
              {real ? (
                <p class="nota" id="nota-previa">Al enviar, guardamos su registro y le enviamos su QR por correo.</p>
              ) : (
                <p class="aviso-corto" id="nota-previa">
                  Vista previa: este formulario todavía no cobra ni guarda datos.
                </p>
              )}
              <button class="boton" type="submit" disabled data-cta={real ? 'enviar_registro' : 'revisar_registro'} data-cta-location="registro">
                {real ? 'Registrarme gratis' : 'Revisar mi registro'}
              </button>
              <p class="campo__error" id="envio-error" role="alert" hidden></p>
              <noscript>
                <p class="nota">Para registrarse, active JavaScript en su navegador o escríbanos a info@coahuilamfgconnect.com.</p>
              </noscript>
            </div>
          </form>

          <section id="confirmado" class="resultado confirmado" hidden tabindex="-1" aria-labelledby="confirmado-titulo">
            <h2 id="confirmado-titulo">Su registro quedó confirmado</h2>
            <p class="entrada" data-conf="mensaje">
              Le enviamos su código QR a <span class="fuerte" data-conf="correo"></span>. Si no lo ve en unos minutos, revise
              la carpeta de correo no deseado.
            </p>
            <figure class="muestra confirmado__qr">
              <img data-conf="qr" alt="" width="240" height="240" />
              <figcaption>
                Folio <span class="fuerte cifra" data-conf="folio"></span>
              </figcaption>
              <p class="nota">Presente este QR en el acceso del Expo Center Laguna, el 9 o el 10 de junio de 2027. Puede tomarle captura.</p>
            </figure>
          </section>

          <section id="resultado" class="resultado" hidden tabindex="-1" aria-labelledby="resultado-titulo">
            <h2 id="resultado-titulo">No se envió nada: así seguiría su registro</h2>
            <p class="entrada">
              Esto es una vista previa. No se cobró, no se guardó ningún dato y no recibirá ningún correo. Cuando el
              registro esté activo, pasaría esto:
            </p>
            <ol class="resultado__pasos">
              <li data-resumen="paso-pago">
                <span class="fuerte">Pago.</span> Le indicaríamos cómo pagar su boleto.
              </li>
              <li data-resumen="paso-gratis" hidden>
                <span class="fuerte">Sin pago.</span> Se registró en la etapa gratis: su boleto no tiene costo.
              </li>
              <li>
                <span class="fuerte">QR por correo.</span> <span data-resumen="cuando-qr">Al quedar registrado</span>, le llegaría a
                <span class="fuerte" data-resumen="correo"></span> un QR individual.
              </li>
              <li>
                <span class="fuerte">Acceso.</span> Presentaría el QR en el Expo Center Laguna el 9 o el 10 de
                junio de 2027.
              </li>
            </ol>

            <figure class="muestra">
              <svg class="muestra__dibujo" viewBox="0 0 240 150" width="240" height="150" role="img" aria-labelledby="muestra-texto">
                <title id="muestra-texto">Dibujo de un sobre de correo: aquí llegará su QR</title>
                <rect x="1" y="1" width="238" height="148" rx="3" fill="#F4F7FB" stroke="#4A5B70" stroke-width="2" stroke-dasharray="6 6"></rect>
                <path d="M70 48h100v62H70z" fill="none" stroke="#095CE4" stroke-width="3" stroke-linejoin="round"></path>
                <path d="M70 48l50 36 50-36" fill="none" stroke="#095CE4" stroke-width="3" stroke-linejoin="round"></path>
              </svg>
              <figcaption class="fuerte">Aquí llegará su QR</figcaption>
              <p class="nota">Cuando el registro esté activo, su QR individual le llegará por correo. Esto no es un boleto.</p>
            </figure>

            <dl class="resumen" aria-label="Datos que escribió (no se guardaron)">
              <div><dt>Nombre</dt><dd data-resumen="nombre"></dd></div>
              <div><dt>Empresa y cargo</dt><dd data-resumen="empresa"></dd></div>
              <div><dt>Tipo de empresa</dt><dd data-resumen="tipo"></dd></div>
              <div><dt>Área y país</dt><dd data-resumen="area"></dd></div>
            </dl>

            <p>
              <button type="button" class="enlace-boton" id="volver">Volver al formulario</button>
            </p>
          </section>
        </div>
        <div class="col-margen nota pila registro__ayuda">
          <p>Gratis hasta el 31 de diciembre de 2026. Después tendrá costo.</p>
          <p>QR individual por correo al quedar registrado.</p>
          <p>
            Dudas: <a class="enlace-suelto" href="mailto:info@coahuilamfgconnect.com">info@coahuilamfgconnect.com</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('form-registro') as HTMLFormElement | null;
  const resultado = document.getElementById('resultado') as HTMLElement | null;
  const volver = document.getElementById('volver');

  if (form && resultado) {
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (boton) boton.disabled = false;

    // Etapa del boleto: hasta el 31 de diciembre de 2026 el registro es gratis
    // y no se pide forma de pago.
    const grupoPago = form.querySelector<HTMLElement>('[data-grupo="pago"]');
    const gratis = Date.now() < Number(grupoPago?.dataset.finGratis ?? 0);
    const opcionesPago = form.querySelector<HTMLElement>('[data-pago-opciones]');
    const notaGratis = form.querySelector<HTMLElement>('[data-pago-gratis]');
    if (opcionesPago) opcionesPago.hidden = gratis;
    if (notaGratis) notaGratis.hidden = !gratis;
    const grupos = ['tipo'];

    const mostrarError = (id: string, mensaje: string, control?: HTMLElement | null) => {
      const p = document.getElementById(`${id}-error`);
      if (!p) return;
      p.textContent = mensaje;
      p.hidden = !mensaje;
      if (control) {
        control.setAttribute('aria-invalid', mensaje ? 'true' : 'false');
        if (mensaje) control.setAttribute('aria-describedby', `${id}-error`);
        else control.removeAttribute('aria-describedby');
      }
    };

    const validar = (): HTMLElement | null => {
      let primero: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[data-error], select[data-error]').forEach((c) => {
        if (c.type === 'text' || c.type === 'email' || c.type === 'tel') c.value = c.value.trim();
        const ok = c.checkValidity();
        mostrarError(c.id, ok ? '' : c.dataset.error ?? 'Revise este campo.', c);
        if (!ok && !primero) primero = c;
      });
      grupos.forEach((g) => {
        const grupo = form.querySelector<HTMLElement>(`[data-grupo="${g}"]`);
        const elegido = form.querySelector<HTMLInputElement>(`input[name="${g}"]:checked`);
        mostrarError(g, elegido ? '' : grupo?.dataset.error ?? '', null);
        if (!elegido && !primero) primero = form.querySelector<HTMLInputElement>(`input[name="${g}"]`);
      });
      return primero;
    };

    form.addEventListener('input', (e) => {
      const c = e.target as HTMLInputElement;
      if (c.getAttribute('aria-invalid') === 'true' && c.checkValidity()) mostrarError(c.id, '', c);
      if (c.name === 'pago' || c.name === 'tipo') mostrarError(c.name, '', null);
    });

    const api = form.dataset.api ?? '';
    const confirmado = document.getElementById('confirmado') as HTMLElement | null;
    const errorEnvio = document.getElementById('envio-error');

    // Registro real: manda los datos a la API del hosting y muestra folio y QR.
    const enviar = async () => {
      if (!boton || !confirmado) return;
      const datos = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      const cuerpo = { ...datos, acepto: (form.elements.namedItem('acepto') as HTMLInputElement).checked };
      const textoBoton = boton.textContent;
      boton.disabled = true;
      boton.textContent = 'Enviando…';
      if (errorEnvio) errorEnvio.hidden = true;
      try {
        const r = await fetch(api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) {
          if (j.campos) {
            let primero: HTMLElement | null = null;
            for (const [campo, msj] of Object.entries(j.campos as Record<string, string>)) {
              const control = form.querySelector<HTMLElement>(`#${campo}`) ?? form.querySelector<HTMLElement>(`[name="${campo}"]`);
              mostrarError(campo, msj, control?.tagName === 'INPUT' && (control as HTMLInputElement).type === 'radio' ? null : control);
              if (!primero) primero = control;
            }
            primero?.focus();
          }
          throw new Error(j.error || 'No pudimos guardar su registro. Intente de nuevo en unos minutos.');
        }
        const poner = (k: string, t: string) => confirmado.querySelectorAll<HTMLElement>(`[data-conf="${k}"]`).forEach((el) => (el.textContent = t));
        poner('correo', String(datos.correo ?? ''));
        poner('folio', j.folio ?? '');
        const img = confirmado.querySelector<HTMLImageElement>('[data-conf="qr"]');
        if (img && j.qr) {
          img.src = j.qr;
          img.alt = `Código QR de acceso, folio ${j.folio}`;
        }
        const titulo = confirmado.querySelector('#confirmado-titulo');
        if (titulo && j.repetido) titulo.textContent = 'Ya estaba registrado con este correo';
        form.hidden = true;
        confirmado.hidden = false;
        confirmado.focus();
        window.scrollTo({ top: confirmado.getBoundingClientRect().top + window.scrollY - 120 });
      } catch (err) {
        if (errorEnvio) {
          errorEnvio.textContent = err instanceof Error ? err.message : 'No pudimos guardar su registro.';
          errorEnvio.hidden = false;
        }
        boton.disabled = false;
        boton.textContent = textoBoton;
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fallo = validar();
      if (fallo) {
        fallo.focus();
        return;
      }
      if (api) {
        enviar();
        return;
      }
      // Campo trampa lleno: no se muestra nada (un robot no necesita la vista previa).
      const trampa = form.querySelector<HTMLInputElement>('#sitio_web');
      if (trampa && trampa.value) return;

      const v = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
      const pago = form.querySelector<HTMLInputElement>('input[name="pago"]:checked')?.value ?? '';
      const poner = (clave: string, texto: string) =>
        resultado.querySelectorAll<HTMLElement>(`[data-resumen="${clave}"]`).forEach((el) => (el.textContent = texto));
      poner('pago', pago.toLowerCase());
      poner('correo', v('correo'));
      poner('nombre', `${v('nombre')} ${v('apellidos')}`);
      poner('empresa', `${v('empresa')}, ${v('cargo')}`);
      poner('area', `${v('area')}, ${v('pais')}`);
      poner('tipo', form.querySelector<HTMLInputElement>('input[name="tipo"]:checked')?.value ?? '');
      poner('cuando-qr', 'Al quedar registrado');
      const ver = (clave: string, si: boolean) => {
        const el = resultado.querySelector<HTMLElement>(`[data-resumen="${clave}"]`);
        if (el) el.hidden = !si;
      };
      ver('paso-pago', !gratis);
      ver('paso-gratis', gratis);

      form.hidden = true;
      resultado.hidden = false;
      resultado.focus();
    });

    volver?.addEventListener('click', () => {
      resultado.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLInputElement>('#nombre')?.focus();
    });
  }
</script>

<style>
  h1 {
    font-size: var(--text-headline-lg);
    line-height: 1.04;
  }
  .registro__cabeza {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: var(--spacing-2xl) var(--spacing-xl);
  }
  /* Fondo: motor en holograma a la derecha; velo marino ≥ 0.80 bajo el texto. */
  .registro__fondo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .registro__fondo :global(picture),
  .registro__fondo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .registro__fondo :global(img) {
    object-fit: cover;
    object-position: 75% 50%;
  }
  .registro__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgb(0 17 47 / 0.92) 0%, rgb(0 17 47 / 0.8) 50%, rgb(0 17 47 / 0.5) 64%, rgb(0 17 47 / 0.12) 100%);
  }
  @media (max-width: 1023px) {
    .registro__velo {
      background: rgb(0 17 47 / 0.82);
    }
  }
  .registro__marco {
    position: relative;
  }
  @media (min-width: 1024px) {
    .registro__margen {
      text-shadow: 0 1px 12px rgb(0 17 47 / 0.95), 0 0 2px rgb(0 17 47 / 0.9);
    }
  }
  .registro__claro {
    padding-block: var(--spacing-2xl) var(--seccion);
  }
  .col-contenido,
  .col-margen {
    min-width: 0;
  }
  .registro__margen {
    align-self: end;
  }
  .aviso-previa {
    font-weight: 600;
    max-width: calc(var(--spacing-measure) + 48px);
    background: var(--color-navy-panel);
    padding: 16px 24px;
  }
  @media (min-width: 1024px) {
    .col-contenido {
      grid-column: 1 / span 8;
    }
    .col-margen {
      grid-column: 9 / span 4;
    }
  }
  .aviso-previa__rotulo {
    display: block;
    color: var(--color-signal-cyan);
    margin-bottom: 4px;
  }

  .form fieldset {
    border: 0;
    margin: 0 0 var(--spacing-xl);
    padding: 0;
    min-width: 0;
  }
  .form__grupo {
    font-family: var(--font-display);
    font-size: var(--text-headline-md);
    font-weight: 700;
    font-variation-settings: 'wdth' 106;
    line-height: 1.15;
    padding: 0;
    margin-bottom: var(--spacing-md);
  }
  .form__fila {
    display: grid;
    gap: var(--spacing-md);
  }
  .form__fila + .form__fila {
    margin-top: var(--spacing-md);
  }
  @media (min-width: 640px) {
    .form__fila {
      grid-template-columns: repeat(2, minmax(0, 1fr));
