---
/**
 * Icono.astro — Phosphor Light (MIT), un solo grosor. Se incrusta en el build;
 * solo donde el ícono informa (más/menos, correo, menú, WhatsApp).
 */
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  nombre: 'plus' | 'minus' | 'envelope' | 'list' | 'x' | 'whatsapp-logo' | 'pause' | 'play';
  tamano?: number;
  class?: string;
}
const { nombre, tamano = 20, class: clase } = Astro.props;
const require = createRequire(import.meta.url);
const svg = readFileSync(require.resolve(`@phosphor-icons/core/assets/light/${nombre}-light.svg`), 'utf8');
const interior = svg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 256 256"
  width={tamano}
  height={tamano}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class={clase}
  set:html={interior}
/>
